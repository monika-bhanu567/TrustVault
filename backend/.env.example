NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Optional: PostgreSQL/Supabase connection string. Takes precedence over DB_*.
DATABASE_URL=
# Isolated database used only by npm run test:uploads and npm run test:grants.
TEST_DATABASE_URL=
# Exact deployed frontend origin, for example https://trustvault.vercel.app.
FRONTEND_ORIGIN=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustvault
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password

VAULT_STORAGE_DIR=./storage
VAULT_ENCRYPTION_KEY=replace_with_64_hex_characters
AUDIT_HMAC_KEY=replace_with_a_long_random_secret

# Backend-only Supabase Storage settings. Never expose these to the Vite frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trustvault-encrypted
# Run `node scripts/migrate-encrypted-storage.mjs` only after these backend-only
# credentials are set. Add --quarantine-missing only after reviewing the report.
